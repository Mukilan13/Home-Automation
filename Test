            System.Text.Encoding.RegisterProvider(
                System.Text.CodePagesEncodingProvider.Instance
            );

            string excelPath = @"\\SharedServer\SharedFolder\100_unique_sample_data.xlsx";
            string connectionString =
                "Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=True;";

            using var stream = File.Open(excelPath, FileMode.Open, FileAccess.Read);
            using var reader = ExcelReaderFactory.CreateReader(stream);

            var dataSet = reader.AsDataSet();

            using var sqlConn = new SqlConnection(connectionString);
            sqlConn.Open();

            foreach (DataTable sheet in dataSet.Tables)
            {
                string sheetName = sheet.TableName;

                // First row is header
                for (int row = 1; row < sheet.Rows.Count; row++)
                {
                    int rowIndex = row; // 1-based index excluding header

                    for (int col = 0; col < sheet.Columns.Count; col++)
                    {
                        string columnName = sheet.Rows[0][col].ToString();
                        string value = sheet.Rows[row][col]?.ToString();

                        InsertRow(
                            sqlConn,
                            sheetName,
                            rowIndex,
                            columnName,
                            value
                        );
                    }
                }
            }

            Console.WriteLine("✅ Excel data inserted successfully.");
        }

        static void InsertRow(
            SqlConnection conn,
            string sheetName,
            int rowIndex,
            string columnName,
            string value
        )
        {
            string query = @"
            INSERT INTO ExcelData
            (SheetName, RowIndex, ColumnName, Value)
            VALUES
            (@SheetName, @RowIndex, @ColumnName, @Value)";

            using var cmd = new SqlCommand(query, conn);
            cmd.Parameters.AddWithValue("@SheetName", sheetName);
            cmd.Parameters.AddWithValue("@RowIndex", rowIndex);
            cmd.Parameters.AddWithValue("@ColumnName", columnName);
            cmd.Parameters.AddWithValue("@Value", value ?? "");

            cmd.ExecuteNonQuery();
        }
    }
