
static void InsertRow(
    SqlConnection conn,
    string sheetName,
    int rowIndex,
    string columnName,
    string value
)
{
    using var cmd = new SqlCommand("dbo.InsertExcelData", conn);
    cmd.CommandType = System.Data.CommandType.StoredProcedure;

    cmd.Parameters.Add("@SheetName", System.Data.SqlDbType.NVarChar, 100)
                  .Value = sheetName;

    cmd.Parameters.Add("@RowIndex", System.Data.SqlDbType.Int)
                  .Value = rowIndex;

    cmd.Parameters.Add("@ColumnName", System.Data.SqlDbType.NVarChar, 100)
                  .Value = columnName;

    cmd.Parameters.Add("@Value", System.Data.SqlDbType.NVarChar)
                  .Value = value ?? string.Empty;

    cmd.ExecuteNonQuery();
}



CREATE PROCEDURE dbo.InsertExcelData
(
    @SheetName   NVARCHAR(100),
    @RowIndex    INT,
    @ColumnName  NVARCHAR(100),
    @Value       NVARCHAR(MAX)
)
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO ExcelData (SheetName, RowIndex, ColumnName, Value)
    SELECT @SheetName, @RowIndex, @ColumnName, @Value
    WHERE NOT EXISTS (
        SELECT 1
        FROM ExcelData
        WHERE SheetName  = @SheetName
          AND RowIndex   = @RowIndex
          AND ColumnName = @ColumnName
    );
END;





using System;
using HexExcelLib;
using Microsoft.Data.SqlClient;

class Program
{
    static void Main()
    {
        string excelPath = @"\\SharedServer\SharedFolder\100_unique_sample_data.xlsx";
        string connectionString =
            "Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=True;";

        using var workbook = new ExcelWorkbook(excelPath);
        using var sqlConn = new SqlConnection(connectionString);
        sqlConn.Open();

        foreach (var sheet in workbook.Sheets)
        {
            string sheetName = sheet.Name;

            // First row is header
            var headerRow = sheet.Rows[0];

            for (int rowIndex = 1; rowIndex < sheet.Rows.Count; rowIndex++)
            {
                var dataRow = sheet.Rows[rowIndex];
                int excelRowIndex = rowIndex; // 1-based (excluding header)

                for (int colIndex = 0; colIndex < headerRow.Cells.Count; colIndex++)
                {
                    string columnName = headerRow.Cells[colIndex]?.Value?.ToString();
                    string value = dataRow.Cells[colIndex]?.Value?.ToString();

                    InsertRow(
                        sqlConn,
                        sheetName,
                        excelRowIndex,
                        columnName,
                        value
                    );
                }
            }
        }

        Console.WriteLine("✅ Excel data inserted successfully.");
    }

    static void InsertRow(
        SqlConnection conn,
        string sheetName,
        int rowIndex,
        string columnName,
        string value
    )
    {
        string sql = @"
            INSERT INTO ExcelData
            (SheetName, RowIndex, ColumnName, Value)
            VALUES
            (@SheetName, @RowIndex, @ColumnName, @Value)";

        using var cmd = new SqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("@SheetName", sheetName);
        cmd.Parameters.AddWithValue("@RowIndex", rowIndex);
        cmd.Parameters.AddWithValue("@ColumnName", columnName);
        cmd.Parameters.AddWithValue("@Value", value ?? "");

        cmd.ExecuteNonQuery();
    }
}


using System;
